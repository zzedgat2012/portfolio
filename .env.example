# Copy to .env (git-ignored). Local development values only.
# Generate secrets with: openssl rand -base64 32

# ---------- Postgres ----------
DATABASE_NAME=portfolio
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_HOST_PORT=5432

# ---------- Strapi (apps/cms) ----------
# APP_KEYS takes four comma-separated values
APP_KEYS=changeme1,changeme2,changeme3,changeme4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# ---------- Web (apps/web) ----------
# Read-only API token created in Strapi admin: Settings > API Tokens (type: Read-only)
CMS_URL=http://localhost:1337
CMS_TOKEN=