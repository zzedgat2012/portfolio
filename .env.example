# Copy to .env (git-ignored). Local development values only.
# There is no database and no CMS server: content is files in content/, edited through Decap.

# ---------- Web (apps/web) ----------
# Content root, relative to apps/web. Default: ../../content. Playwright sets e2e/content.
# CONTENT_DIR=../../content

# ---------- Decap OAuth Worker (apps/decap-auth) ----------
# Secrets live in apps/decap-auth/.dev.vars locally (see .dev.vars.example) and as
# `wrangler secret put GITHUB_CLIENT_SECRET` in Cloudflare. Never here, never in config.yml.
